<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <!-- NAudio.Lame (used by the native mp3 export path) requires NAudio.Core 2.1.0,
                 while the main NAudio 2.0.1 package brings NAudio.Core 2.0.0 - redirect so both
                 consumers load the single resolved 2.1.0 assembly at runtime. -->
            <dependentAssembly>
                <assemblyIdentity name="NAudio.Core" publicKeyToken="e279aa5131008a41" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-2.1.0.0" newVersion="2.1.0.0" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>
